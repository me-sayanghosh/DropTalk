PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/droptalk

JWT_SECRET=your-secure-jwt-secret-here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
REDIS_URL=redis://127.0.0.1:6379
CLIENT_ORIGIN=http://localhost:4000,http://localhost:3000
CORS_ORIGIN=http://localhost:4000,http://localhost:3000
GEMINI_API_KEY=

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DropTalk Security" <no-reply@droptalk.com>

# Next.js Client Environment Variables
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_SERVER_URL=
